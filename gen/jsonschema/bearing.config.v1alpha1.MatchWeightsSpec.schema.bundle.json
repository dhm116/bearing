{
  "$defs": {
    "bearing.config.v1alpha1.LinkEvidence.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "LinkEvidence marks a MatchWeight as the weight of non-authoritative links.",
      "properties": {},
      "title": "Link Evidence",
      "type": "object"
    },
    "bearing.config.v1alpha1.MatchWeight.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MatchWeight is the weight of one kind of evidence for one subject kind\n (docs/spec/data-model.md, \"Matching\").",
      "patternProperties": {
        "^(weightPpm)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The weight, in parts per million, 1 to 1000000."
        }
      },
      "properties": {
        "kind": {
          "default": "",
          "description": "The subject kind. Required.",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/bearing.config.v1alpha1.LinkEvidence.schema.json",
          "description": "A non-authoritative link; link is not a declarable match method."
        },
        "method": {
          "anyOf": [
            {
              "enum": [
                "MATCH_METHOD_UNSPECIFIED",
                "MATCH_METHOD_EXACT",
                "MATCH_METHOD_EMAIL",
                "MATCH_METHOD_NAME",
                "MATCH_METHOD_MEMBERS"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "description": "A matching method.",
          "title": "Match Method"
        },
        "predicate": {
          "default": "",
          "description": "See source.",
          "type": "string"
        },
        "source": {
          "default": "",
          "description": "With predicate: this weight is an override for that source's field.\n Both empty: the default for the kind and method. One without the other\n is invalid.",
          "type": "string"
        },
        "weight_ppm": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The weight, in parts per million, 1 to 1000000."
        }
      },
      "title": "Match Weight",
      "type": "object"
    },
    "bearing.config.v1alpha1.MatchWeightsSpec.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MatchWeightsSpec is a MatchWeights' content.",
      "properties": {
        "weights": {
          "description": "The weights.",
          "items": {
            "$ref": "#/$defs/bearing.config.v1alpha1.MatchWeight.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Match Weights Spec",
      "type": "object"
    }
  },
  "$id": "bearing.config.v1alpha1.MatchWeightsSpec.schema.bundle.json",
  "$ref": "#/$defs/bearing.config.v1alpha1.MatchWeightsSpec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
