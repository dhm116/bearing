{
  "$defs": {
    "bearing.config.v1alpha1.Assertion.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Assertion is how supports become an asserted fact: the confidence\n threshold, systems that copy each other, and per-predicate precedence.",
      "patternProperties": {
        "^(apiVersion)$": {
          "default": "",
          "description": "\"bearing/v1alpha1\".",
          "type": "string"
        }
      },
      "properties": {
        "api_version": {
          "default": "",
          "description": "\"bearing/v1alpha1\".",
          "type": "string"
        },
        "kind": {
          "default": "",
          "description": "\"Assertion\".",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/bearing.config.v1alpha1.Metadata.schema.json",
          "description": "The resource's name."
        },
        "spec": {
          "$ref": "#/$defs/bearing.config.v1alpha1.AssertionSpec.schema.json",
          "description": "The settings."
        }
      },
      "title": "Assertion",
      "type": "object"
    },
    "bearing.config.v1alpha1.AssertionSpec.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AssertionSpec is an Assertion's content.",
      "patternProperties": {
        "^(confidenceGroups)$": {
          "description": "Groups of source systems that copy each other, so their confidence counts\n once (docs/spec/data-model.md, \"Confidence\").",
          "items": {
            "$ref": "#/$defs/bearing.config.v1alpha1.ConfidenceGroup.schema.json"
          },
          "type": "array"
        },
        "^(thresholdPpm)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The confidence at which a fact is asserted, in parts per million."
        }
      },
      "properties": {
        "confidence_groups": {
          "description": "Groups of source systems that copy each other, so their confidence counts\n once (docs/spec/data-model.md, \"Confidence\").",
          "items": {
            "$ref": "#/$defs/bearing.config.v1alpha1.ConfidenceGroup.schema.json"
          },
          "type": "array"
        },
        "precedence": {
          "description": "Per-predicate precedence among source systems.",
          "items": {
            "$ref": "#/$defs/bearing.config.v1alpha1.PredicatePrecedence.schema.json"
          },
          "type": "array"
        },
        "threshold_ppm": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The confidence at which a fact is asserted, in parts per million."
        }
      },
      "title": "Assertion Spec",
      "type": "object"
    },
    "bearing.config.v1alpha1.ConfidenceGroup.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ConfidenceGroup is source systems that count as one in the noisy-OR.",
      "properties": {
        "systems": {
          "description": "The source systems, by namespace.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Confidence Group",
      "type": "object"
    },
    "bearing.config.v1alpha1.Metadata.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Metadata identifies a resource.",
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Free-form labels for selecting and grouping.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "default": "",
          "description": "Unique among resources of one kind: lowercase letters, digits, \"-\" and\n \"_\". Required.",
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "bearing.config.v1alpha1.PredicatePrecedence.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "PredicatePrecedence is the ordered list of source systems that decides a\n predicate's conflicts (docs/spec/data-model.md, \"Conflicts\").",
      "properties": {
        "predicate": {
          "default": "",
          "description": "The predicate.",
          "type": "string"
        },
        "systems": {
          "description": "The source systems, first wins.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Predicate Precedence",
      "type": "object"
    }
  },
  "$id": "bearing.config.v1alpha1.Assertion.schema.bundle.json",
  "$ref": "#/$defs/bearing.config.v1alpha1.Assertion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
