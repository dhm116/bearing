{
  "$defs": {
    "bearing.model.v1alpha1.Fact.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Fact is (subject, predicate, object). Status, confidence and valid time\n are computed from its supports.",
      "patternProperties": {
        "^(factId)$": {
          "default": "",
          "description": "Lowercase hex SHA-256 of the JCS form of subject_id, predicate, object.",
          "type": "string"
        },
        "^(subjectId)$": {
          "default": "",
          "description": "The canonical (survivor) subject ID.",
          "type": "string"
        }
      },
      "properties": {
        "fact_id": {
          "default": "",
          "description": "Lowercase hex SHA-256 of the JCS form of subject_id, predicate, object.",
          "type": "string"
        },
        "object": {
          "$ref": "#/$defs/bearing.model.v1alpha1.FactObject.schema.json",
          "description": "The object."
        },
        "predicate": {
          "default": "",
          "description": "A registered predicate or \u003cnamespace\u003e.\u003cattribute\u003e.",
          "type": "string"
        },
        "subject_id": {
          "default": "",
          "description": "The canonical (survivor) subject ID.",
          "type": "string"
        }
      },
      "title": "Fact",
      "type": "object"
    },
    "bearing.model.v1alpha1.FactObject.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "FactObject is a fact's object: { \"subject_id\" } for a relation, or\n { \"type\", \"value\" } for an attribute.",
      "patternProperties": {
        "^(subjectId)$": {
          "default": "",
          "description": "A relation's object. Set alone.",
          "type": "string"
        }
      },
      "properties": {
        "subject_id": {
          "default": "",
          "description": "A relation's object. Set alone.",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^VALUE_TYPE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "VALUE_TYPE_STRING",
                "VALUE_TYPE_FLOAT",
                "VALUE_TYPE_BOOL",
                "VALUE_TYPE_TIME",
                "VALUE_TYPE_JSON"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "An attribute's value type. Set with value.",
          "title": "Value Type"
        },
        "value": {
          "$ref": "#/$defs/google.protobuf.Value.schema.json",
          "description": "An attribute's value, in canonical form. Set with type."
        }
      },
      "title": "Fact Object",
      "type": "object"
    },
    "google.protobuf.Value.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Value"
    }
  },
  "$id": "bearing.model.v1alpha1.Fact.schema.bundle.json",
  "$ref": "#/$defs/bearing.model.v1alpha1.Fact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
