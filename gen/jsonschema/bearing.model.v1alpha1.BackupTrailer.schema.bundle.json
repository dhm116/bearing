{
  "$defs": {
    "bearing.model.v1alpha1.BackupTrailer.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "BackupTrailer closes a backup stream. A stream without one is truncated.",
      "properties": {
        "records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The number of record frames."
        },
        "sha256": {
          "default": null,
          "description": "SHA-256 of every byte of the stream before this frame.",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        }
      },
      "title": "Backup Trailer",
      "type": "object"
    }
  },
  "$id": "bearing.model.v1alpha1.BackupTrailer.schema.bundle.json",
  "$ref": "#/$defs/bearing.model.v1alpha1.BackupTrailer.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
