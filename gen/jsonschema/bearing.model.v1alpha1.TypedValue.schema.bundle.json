{
  "$defs": {
    "bearing.model.v1alpha1.TypedValue.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "TypedValue is an attribute value with its type.",
      "properties": {
        "type": {
          "anyOf": [
            {
              "pattern": "^VALUE_TYPE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "VALUE_TYPE_STRING",
                "VALUE_TYPE_FLOAT",
                "VALUE_TYPE_BOOL",
                "VALUE_TYPE_TIME",
                "VALUE_TYPE_JSON"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "The value type. Required.",
          "title": "Value Type"
        },
        "value": {
          "$ref": "#/$defs/google.protobuf.Value.schema.json",
          "description": "string and time are strings (time in the 6-digit canonical form), float\n a number, bool a boolean, json any JSON value."
        }
      },
      "title": "Typed Value",
      "type": "object"
    },
    "google.protobuf.Value.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Value"
    }
  },
  "$id": "bearing.model.v1alpha1.TypedValue.schema.bundle.json",
  "$ref": "#/$defs/bearing.model.v1alpha1.TypedValue.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
