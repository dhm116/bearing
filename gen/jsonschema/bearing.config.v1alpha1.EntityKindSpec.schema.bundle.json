{
  "$defs": {
    "bearing.config.v1alpha1.AttributeSpec.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AttributeSpec declares one attribute. A name has one shape across the whole\n vocabulary, so an attribute that already exists must repeat its shape.",
      "properties": {
        "cardinality": {
          "anyOf": [
            {
              "pattern": "^CARDINALITY_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CARDINALITY_ONE",
                "CARDINALITY_MANY"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Cardinality"
        },
        "conflict": {
          "anyOf": [
            {
              "pattern": "^CONFLICT_POLICY_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CONFLICT_POLICY_NONE",
                "CONFLICT_POLICY_ONE",
                "CONFLICT_POLICY_SET"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Conflict Policy"
        },
        "name": {
          "default": "",
          "description": "Lowercase letters, digits and \"_\". Required.",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^VALUE_TYPE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "VALUE_TYPE_STRING",
                "VALUE_TYPE_FLOAT",
                "VALUE_TYPE_BOOL",
                "VALUE_TYPE_TIME",
                "VALUE_TYPE_JSON"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Value Type"
        }
      },
      "title": "Attribute Spec",
      "type": "object"
    },
    "bearing.config.v1alpha1.EntityKindSpec.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "EntityKindSpec is an EntityKind's content.",
      "properties": {
        "attributes": {
          "description": "Attributes a record of this kind may carry.",
          "items": {
            "$ref": "#/$defs/bearing.config.v1alpha1.AttributeSpec.schema.json"
          },
          "type": "array"
        },
        "extends": {
          "default": "",
          "description": "The parent kind, core or configured, such as \"Component\". Empty: none,\n so the kind answers Get, Related, Find and Changes but none of the MVP\n questions.",
          "type": "string"
        },
        "name": {
          "default": "",
          "description": "The kind, \"\u003cnamespace\u003e.\u003cKind\u003e\" such as \"k8s.Service\". The namespace names\n the vocabulary that defines the kind; \"bearing\" is reserved. Required.",
          "type": "string"
        },
        "relations": {
          "description": "Relations a record of this kind may have, with this kind in their domain.",
          "items": {
            "$ref": "#/$defs/bearing.config.v1alpha1.RelationSpec.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Entity Kind Spec",
      "type": "object"
    },
    "bearing.config.v1alpha1.RelationSpec.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelationSpec declares one relation predicate. A predicate that already\n exists must repeat its shape; its domain and range grow by these kinds.",
      "properties": {
        "cardinality": {
          "anyOf": [
            {
              "pattern": "^CARDINALITY_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CARDINALITY_ONE",
                "CARDINALITY_MANY"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Cardinality"
        },
        "conflict": {
          "anyOf": [
            {
              "pattern": "^CONFLICT_POLICY_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CONFLICT_POLICY_NONE",
                "CONFLICT_POLICY_ONE",
                "CONFLICT_POLICY_SET"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Conflict Policy"
        },
        "domain": {
          "description": "Kinds whose records may be the subject, besides the EntityKind itself.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "description": "Lowercase letters, digits and \"_\". Required.",
          "type": "string"
        },
        "range": {
          "description": "Kinds whose records may be the object. Required.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Relation Spec",
      "type": "object"
    }
  },
  "$id": "bearing.config.v1alpha1.EntityKindSpec.schema.bundle.json",
  "$ref": "#/$defs/bearing.config.v1alpha1.EntityKindSpec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
