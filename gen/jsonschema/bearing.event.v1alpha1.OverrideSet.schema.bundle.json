{
  "$defs": {
    "bearing.event.v1alpha1.Actor.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Actor is who asked for an event: a person or an agent acting for one.",
      "properties": {
        "agent": {
          "default": false,
          "description": "True for an agent.",
          "type": "boolean"
        },
        "subject": {
          "default": "",
          "description": "OIDC subject or agent token ID.",
          "type": "string"
        }
      },
      "title": "Actor",
      "type": "object"
    },
    "bearing.event.v1alpha1.OverrideSet.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "OverrideSet is a manual snapshot of (subject, predicate) that decides\n status.",
      "patternProperties": {
        "^(subjectId)$": {
          "default": "",
          "description": "The subject.",
          "type": "string"
        },
        "^(validFrom)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "Absent: unbounded."
        },
        "^(validTo)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "Absent: open."
        }
      },
      "properties": {
        "actor": {
          "$ref": "#/$defs/bearing.event.v1alpha1.Actor.schema.json",
          "description": "Who asked."
        },
        "objects": {
          "description": "The objects that are asserted; every other object is overridden.",
          "items": {
            "$ref": "#/$defs/bearing.model.v1alpha1.FactObject.schema.json"
          },
          "type": "array"
        },
        "predicate": {
          "default": "",
          "description": "The predicate.",
          "type": "string"
        },
        "reason": {
          "default": "",
          "description": "Why.",
          "type": "string"
        },
        "subject_id": {
          "default": "",
          "description": "The subject.",
          "type": "string"
        },
        "valid_from": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "Absent: unbounded."
        },
        "valid_to": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "Absent: open."
        }
      },
      "title": "Override Set",
      "type": "object"
    },
    "bearing.model.v1alpha1.FactObject.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "FactObject is a fact's object: { \"subject_id\" } for a relation, or\n { \"type\", \"value\" } for an attribute.",
      "patternProperties": {
        "^(subjectId)$": {
          "default": "",
          "description": "A relation's object. Set alone.",
          "type": "string"
        }
      },
      "properties": {
        "subject_id": {
          "default": "",
          "description": "A relation's object. Set alone.",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^VALUE_TYPE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "VALUE_TYPE_STRING",
                "VALUE_TYPE_FLOAT",
                "VALUE_TYPE_BOOL",
                "VALUE_TYPE_TIME",
                "VALUE_TYPE_JSON"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "An attribute's value type. Set with value.",
          "title": "Value Type"
        },
        "value": {
          "$ref": "#/$defs/google.protobuf.Value.schema.json",
          "description": "An attribute's value, in canonical form. Set with type."
        }
      },
      "title": "Fact Object",
      "type": "object"
    },
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "google.protobuf.Value.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Value"
    }
  },
  "$id": "bearing.event.v1alpha1.OverrideSet.schema.bundle.json",
  "$ref": "#/$defs/bearing.event.v1alpha1.OverrideSet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
