{
  "$defs": {
    "bearing.event.v1alpha1.AuditCheckpoint.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AuditCheckpoint is a point of the chain written outside the store, so a\n rewritten or cut-off chain no longer matches it (threat model C-AUDIT-3).",
      "patternProperties": {
        "^(headHash)$": {
          "default": null,
          "description": "That record's hash.",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "^(keyId)$": {
          "default": "",
          "description": "The signing key's ID, when a key is configured.",
          "type": "string"
        }
      },
      "properties": {
        "head_hash": {
          "default": null,
          "description": "That record's hash.",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "key_id": {
          "default": "",
          "description": "The signing key's ID, when a key is configured.",
          "type": "string"
        },
        "seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The sequence number of the last record covered."
        },
        "signature": {
          "default": null,
          "description": "The signature over seq, head_hash and time, when a key is configured. The\n algorithm and key trust model are fixed with the AuditLog contract (#60).",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "When the checkpoint was written."
        }
      },
      "title": "Audit Checkpoint",
      "type": "object"
    },
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "$id": "bearing.event.v1alpha1.AuditCheckpoint.schema.bundle.json",
  "$ref": "#/$defs/bearing.event.v1alpha1.AuditCheckpoint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
