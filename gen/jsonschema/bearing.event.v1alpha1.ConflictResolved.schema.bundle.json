{
  "$defs": {
    "bearing.event.v1alpha1.ConflictResolved.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ConflictResolved reports a standing conflict that closed, with its\n resolution.",
      "properties": {
        "conflict": {
          "$ref": "#/$defs/bearing.model.v1alpha1.Conflict.schema.json",
          "description": "The conflict, with resolution set."
        }
      },
      "title": "Conflict Resolved",
      "type": "object"
    },
    "bearing.model.v1alpha1.Authority.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Authority is a source's claim to be the source of record. It is a message\n so levels can be added later without breaking declarations or overrides.",
      "properties": {
        "authoritative": {
          "default": false,
          "description": "True when the source is the source of record. Default false.",
          "type": "boolean"
        }
      },
      "title": "Authority",
      "type": "object"
    },
    "bearing.model.v1alpha1.Conflict.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Conflict is a disagreement on (subject, predicate) across source systems.",
      "patternProperties": {
        "^(subjectId)$": {
          "default": "",
          "description": "The canonical subject ID.",
          "type": "string"
        },
        "^(validFrom)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "When the disagreement starts in valid time."
        },
        "^(validTo)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "When it ends; absent means open."
        }
      },
      "properties": {
        "positions": {
          "description": "Each system's side.",
          "items": {
            "$ref": "#/$defs/bearing.model.v1alpha1.ConflictPosition.schema.json"
          },
          "type": "array"
        },
        "predicate": {
          "default": "",
          "description": "The predicate.",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "pattern": "^CONFLICT_RESOLUTION_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CONFLICT_RESOLUTION_OVERRIDE",
                "CONFLICT_RESOLUTION_PRECEDENCE",
                "CONFLICT_RESOLUTION_AUTHORITY",
                "CONFLICT_RESOLUTION_EVIDENCE_CHANGED"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "The rule that decided it; unspecified while it stands.",
          "title": "Conflict Resolution"
        },
        "subject_id": {
          "default": "",
          "description": "The canonical subject ID.",
          "type": "string"
        },
        "valid_from": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "When the disagreement starts in valid time."
        },
        "valid_to": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "When it ends; absent means open."
        }
      },
      "title": "Conflict",
      "type": "object"
    },
    "bearing.model.v1alpha1.ConflictPosition.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ConflictPosition is one source system's side of a conflict.",
      "patternProperties": {
        "^(sourceSystem)$": {
          "default": "",
          "description": "The source system (namespace), or a core group.",
          "type": "string"
        }
      },
      "properties": {
        "authority": {
          "$ref": "#/$defs/bearing.model.v1alpha1.Authority.schema.json",
          "description": "Whether the system is authoritative for the field."
        },
        "objects": {
          "description": "The objects the system supports at or above the threshold.",
          "items": {
            "$ref": "#/$defs/bearing.model.v1alpha1.FactObject.schema.json"
          },
          "type": "array"
        },
        "source_system": {
          "default": "",
          "description": "The source system (namespace), or a core group.",
          "type": "string"
        }
      },
      "title": "Conflict Position",
      "type": "object"
    },
    "bearing.model.v1alpha1.FactObject.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "FactObject is a fact's object: { \"subject_id\" } for a relation, or\n { \"type\", \"value\" } for an attribute.",
      "patternProperties": {
        "^(subjectId)$": {
          "default": "",
          "description": "A relation's object. Set alone.",
          "type": "string"
        }
      },
      "properties": {
        "subject_id": {
          "default": "",
          "description": "A relation's object. Set alone.",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^VALUE_TYPE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "VALUE_TYPE_STRING",
                "VALUE_TYPE_FLOAT",
                "VALUE_TYPE_BOOL",
                "VALUE_TYPE_TIME",
                "VALUE_TYPE_JSON"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "An attribute's value type. Set with value.",
          "title": "Value Type"
        },
        "value": {
          "$ref": "#/$defs/google.protobuf.Value.schema.json",
          "description": "An attribute's value, in canonical form. Set with type."
        }
      },
      "title": "Fact Object",
      "type": "object"
    },
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "google.protobuf.Value.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Value"
    }
  },
  "$id": "bearing.event.v1alpha1.ConflictResolved.schema.bundle.json",
  "$ref": "#/$defs/bearing.event.v1alpha1.ConflictResolved.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
