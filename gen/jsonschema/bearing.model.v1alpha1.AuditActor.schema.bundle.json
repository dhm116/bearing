{
  "$defs": {
    "bearing.model.v1alpha1.AuditActor.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AuditActor is who or what made a change.",
      "properties": {
        "id": {
          "default": "",
          "description": "A stable ID, never a token or a secret (threat model C-AUDIT-6): for an\n event's actor, its Actor.subject unchanged; for a component,\n \"system:\u003cname\u003e\" such as \"system:resolver\" or \"system:scheduler\".",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "pattern": "^AUDIT_ACTOR_KIND_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "AUDIT_ACTOR_KIND_PERSON",
                "AUDIT_ACTOR_KIND_AGENT",
                "AUDIT_ACTOR_KIND_SYSTEM"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "What acted.",
          "title": "Audit Actor Kind"
        }
      },
      "title": "Audit Actor",
      "type": "object"
    }
  },
  "$id": "bearing.model.v1alpha1.AuditActor.schema.bundle.json",
  "$ref": "#/$defs/bearing.model.v1alpha1.AuditActor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
