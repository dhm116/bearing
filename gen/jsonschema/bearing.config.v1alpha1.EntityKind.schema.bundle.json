{
  "$defs": {
    "bearing.config.v1alpha1.AttributeSpec.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AttributeSpec declares one attribute. A name has one shape across the whole\n vocabulary, so an attribute that already exists must repeat its shape.",
      "properties": {
        "cardinality": {
          "anyOf": [
            {
              "pattern": "^CARDINALITY_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CARDINALITY_ONE",
                "CARDINALITY_MANY"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Cardinality"
        },
        "conflict": {
          "anyOf": [
            {
              "pattern": "^CONFLICT_POLICY_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CONFLICT_POLICY_NONE",
                "CONFLICT_POLICY_ONE",
                "CONFLICT_POLICY_SET"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Conflict Policy"
        },
        "name": {
          "default": "",
          "description": "Lowercase letters, digits and \"_\". Required.",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^VALUE_TYPE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "VALUE_TYPE_STRING",
                "VALUE_TYPE_FLOAT",
                "VALUE_TYPE_BOOL",
                "VALUE_TYPE_TIME",
                "VALUE_TYPE_JSON"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Value Type"
        }
      },
      "title": "Attribute Spec",
      "type": "object"
    },
    "bearing.config.v1alpha1.EntityKind.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "EntityKind adds a kind to the vocabulary beside the core kinds (ADR 10).\n Configured kinds only grow: a stored kind's parent and its attributes' and\n relations' shapes never change, and a kind dropped from config is retired,\n not deleted.",
      "patternProperties": {
        "^(apiVersion)$": {
          "default": "",
          "description": "\"bearing/v1alpha1\".",
          "type": "string"
        }
      },
      "properties": {
        "api_version": {
          "default": "",
          "description": "\"bearing/v1alpha1\".",
          "type": "string"
        },
        "kind": {
          "default": "",
          "description": "\"EntityKind\".",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/bearing.config.v1alpha1.Metadata.schema.json",
          "description": "Names the resource only, for example \"k8s-service\"; the kind's identity\n is spec.name, so renaming the resource changes nothing in the store."
        },
        "spec": {
          "$ref": "#/$defs/bearing.config.v1alpha1.EntityKindSpec.schema.json",
          "description": "The kind."
        }
      },
      "title": "Entity Kind",
      "type": "object"
    },
    "bearing.config.v1alpha1.EntityKindSpec.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "EntityKindSpec is an EntityKind's content.",
      "properties": {
        "attributes": {
          "description": "Attributes a record of this kind may carry.",
          "items": {
            "$ref": "#/$defs/bearing.config.v1alpha1.AttributeSpec.schema.json"
          },
          "type": "array"
        },
        "extends": {
          "default": "",
          "description": "The parent kind, core or configured, such as \"Component\"; boot refuses\n an unknown parent or a cycle. Empty: none,\n so the kind answers Get, Related, Find and Changes but none of the MVP\n questions.",
          "type": "string"
        },
        "name": {
          "default": "",
          "description": "The kind, \"\u003cnamespace\u003e.\u003cKind\u003e\" such as \"k8s.Service\". The namespace names\n the vocabulary that defines the kind; \"bearing\" is reserved. It is the\n kind's identity in the store. Required.",
          "type": "string"
        },
        "relations": {
          "description": "Relations a record of this kind may have, with this kind in their domain.",
          "items": {
            "$ref": "#/$defs/bearing.config.v1alpha1.RelationSpec.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Entity Kind Spec",
      "type": "object"
    },
    "bearing.config.v1alpha1.Metadata.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Metadata identifies a resource.",
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Free-form labels for selecting and grouping.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "default": "",
          "description": "Unique among resources of one kind: lowercase letters, digits, \"-\" and\n \"_\". Required.",
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "bearing.config.v1alpha1.RelationSpec.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelationSpec declares one relation predicate. A predicate that already\n exists must repeat its shape; its domain and range grow by these kinds,\n and a core predicate grows only by configured kinds. Boot refuses a kind\n the vocabulary doesn't hold.",
      "properties": {
        "cardinality": {
          "anyOf": [
            {
              "pattern": "^CARDINALITY_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CARDINALITY_ONE",
                "CARDINALITY_MANY"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Cardinality"
        },
        "conflict": {
          "anyOf": [
            {
              "pattern": "^CONFLICT_POLICY_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CONFLICT_POLICY_NONE",
                "CONFLICT_POLICY_ONE",
                "CONFLICT_POLICY_SET"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Required.",
          "title": "Conflict Policy"
        },
        "domain": {
          "description": "Kinds whose records may be the subject, besides the EntityKind itself.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "description": "Lowercase letters, digits and \"_\". Required.",
          "type": "string"
        },
        "range": {
          "description": "Kinds whose records may be the object. Required.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Relation Spec",
      "type": "object"
    }
  },
  "$id": "bearing.config.v1alpha1.EntityKind.schema.bundle.json",
  "$ref": "#/$defs/bearing.config.v1alpha1.EntityKind.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
